# Aidan runs out of the box with NO config: local Chromium + a public demo app.
# Copy to .env only if you want to change the defaults below.

# ================= BRAIN (the reasoning model) =================
# Pick ONE. Default is Anthropic (best). Or run a fully-local open-source model.
MODEL_PROVIDER=anthropic          # anthropic | openai

# -- Option A: Anthropic (recommended). Get a key at console.anthropic.com --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# -- Option B: fully local, zero cloud, via Ollama (https://ollama.com) --
#   1) ollama pull qwen2.5vl        (a vision model that can see the screen)
#   2) set MODEL_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5vl

# ================= LIVEBOX (the browser) =================
LIVEBOX_PROVIDER=local            # local (Playwright Chromium, default) | steel
# STEEL_API_KEY=                  # only if LIVEBOX_PROVIDER=steel

# ================= TARGET PRODUCT TO DEMO =================
# Defaults to a stable public app. Point these at YOUR product to demo it.
DEMO_NAME=TodoMVC (a demo task app)
DEMO_START_URL=https://demo.playwright.dev/todomvc
DEMO_AUTH_MODE=none              # none | login | shared_link
# DEMO_USERNAME=
# DEMO_PASSWORD=

# ================= SERVER =================
PORT=8787

# ================= VOICE =================
# Local STT finalizes after roughly 0.75s of silence. Lower values respond
# sooner but split natural pauses into separate turns; do not use 1 or 2.
# LOW_ENERGY_PACKET_TARGET=4

# ================= DURABLE MULTI-TENANT BACKBONE =================
# Enabling DATABASE_URL switches the v2 product/catalog/session APIs from
# process-local JSON to PostgreSQL with tenant row-level security.
# Runtime URL MUST be a non-superuser/non-BYPASSRLS role.
# DATABASE_URL=postgres://aidan_runtime:aidan_runtime@localhost:5433/aidan
# Migration URL is used only by db:migrate.
# DATABASE_ADMIN_URL=postgres://aidan:aidan@localhost:5433/aidan
# AIDAN_RUNTIME_PASSWORD=aidan_runtime
# REDIS_URL=redis://localhost:6379
# ADMIN_ORG_ID=00000000-0000-4000-8000-000000000001
# WORKER_ID=aidan-worker-1
# OBJECT_STORE_PATH=./data/objects
# Multi-host object storage (S3, R2, MinIO). When all required values are set,
# this replaces OBJECT_STORE_PATH.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=aidan-runtime
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

# Production API identity. Bearer tokens are verified against JWKS (RS256);
# organization and role are read only after signature/issuer/audience validation.
# OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
# OIDC_ISSUER=https://id.example.com/
# OIDC_AUDIENCE=aidan-api
# OIDC_ORGANIZATION_CLAIM=organization_id
# OIDC_ROLE_CLAIM=roles

# Required before issuing revocable prospect/embed links. Use 32+ random
# characters; grants are additionally stored in PostgreSQL and can be revoked.
# EMBED_TOKEN_SECRET=

# Mapping breadth is data-driven and can be overridden per API request.
MAPPING_MAX_JOBS=25
MAPPING_MAX_SCREENS=25
MAPPING_NAV_DEPTH=8
SURVEY_MAX_VISITS=60
SURVEY_CONTROLS_PER_SCREEN=60
SNAPSHOT_ELEMENT_CAP=50
EXPLORER_MAX_STEPS=40
EXPLORER_MAX_MS=600000
PROOF_WAIT_MS=20000
CONTENT_WAIT_MS=20000
VERIFY_REQUIRED_RUNS=2
VERIFY_MUTATION_RUNS=3
PLANNER_DOC_HINTS=30
PLANNER_CONTROLS_PER_SCREEN=40
# How long to keep looking for a recorded control before calling it absent.
# settle() returns on network quiet, which is often before the view has mounted.
STEP_RESOLVE_WAIT_MS=3000
# How many alignment rejections the explorer may recover from before failing.
EXPLORER_MAX_ALIGNMENT_RETRIES=2
# Goal-scoped product knowledge given to the explorer for orientation only —
# terminology, feature intent, prerequisites, roughly where a feature lives.
# It is explicitly NOT a plan: the explorer may act only on controls visible on
# the current screen. Set EXPLORER_KNOWLEDGE_CHUNKS=0 to disable the briefing.
EXPLORER_KNOWLEDGE_CHUNKS=4
EXPLORER_KNOWLEDGE_CHUNK_CHARS=600
# Additive rollout: when false, ingestion/planning use the original UI-only path.
DOCUMENT_JOURNEY_PLANNING=false
# Share of job slots documentation may claim. Clicking is the primary discovery
# method; a documented procedure only earns a slot when every one of its steps
# matches an observed control AND yields a replayable click path.
PLANNER_DOCUMENT_SHARE=0.25
DOC_PROCEDURE_MAX_SECTIONS=80
DOC_PROCEDURE_BATCH_CHARS=24000
DOC_PLANNING_CHUNK_LIMIT=10000
MODEL_MAX_TOKENS=2048
CRAWL_DISCOVER_DEPTH=3
CRAWL_DISCOVER_LIMIT=1000
CRAWL_CONCURRENCY=8
CRAWL_RENDER_CONCURRENCY=3
MAPPING_WORKER_EMBEDDED=true
MAPPING_JOB_LEASE_SECONDS=1800
MAPPING_JOB_MAX_ATTEMPTS=4
MAPPING_QUEUE_POLL_MS=750
# Refuse shallow catalogs in production (0 keeps legacy migration permissive).
PUBLISH_MIN_COVERAGE=0.4
PUBLISH_REQUIRE_ALL_ROLES=true
PUBLISH_CRITICAL_IMPORTANCE=3

# Hard live-latency budgets. Lexical retrieval returns when semantic retrieval
# or the embedding provider misses these deadlines.
KNOWLEDGE_RETRIEVAL_BUDGET_MS=400
EMBEDDING_HTTP_TIMEOUT_MS=1200

# Browser fleet limits are cluster-wide when REDIS_URL is configured.
MAX_CONCURRENT_DEMOS=4
MAX_CONCURRENT_MAPPINGS=1
SESSION_IDLE_MS=900000
# WebSocket reconnect grace and Steel crash-recovery fencing.
SESSION_RECONNECT_GRACE_MS=30000
SESSION_RECOVERY_LEASE_SECONDS=45
# Required for worker-aware WebSocket redirects in a multi-replica deployment.
# WORKER_PUBLIC_URL=https://worker-1.example.com

# External browser fleet. Local Playwright remains the development default.
# LIVEBOX_PROVIDER=steel
# STEEL_API_KEY=
# STEEL_REGION=bom
# STEEL_SESSION_TIMEOUT_MS=1800000

# Optional KMS-backed secret provider. Never put client passwords in product
# records; store only a credential_refs provider/path pair.
# VAULT_ADDR=https://vault.internal
# VAULT_TOKEN=
# VAULT_MOUNT=secret
# POST /api/v2/credentials writes login/session material to Vault and stores only
# the returned provider/path reference in PostgreSQL.
# Local UAT only: enables read-only `<root>/<secretPath>/.auth.local.json`
# credential references. Files must be mode 0600. Never enable this in production.
# LOCAL_SECRET_ROOT=/absolute/path/to/aidan/content

# Web knowledge sync is HTTPS-only and blocks local/private IPs. Enable plain
# HTTP only for a controlled development connector (private IPs remain blocked).
# ALLOW_INSECURE_KNOWLEDGE_HTTP=false

# ---------------------------------------------------------------------------
# Safety policy — what autonomous exploration may never do.
# ---------------------------------------------------------------------------
# Enforced at the execution layer, not in a prompt: an exploring agent will
# eventually try to delete a record or log itself out, and only a structural
# refusal stops it. Three categories, each a comma-separated list:
#
#   NEVER_TOUCH  areas that are off limits however they are reached. Checked
#                against both a control's name and a destination URL path, and
#                NOT overridable by a per-product allowActions entry.
#   DESTRUCTIVE  irreversible or externally visible acts. Checked against a
#                control's name; for a navigation, against the URL path only.
#   MUTATING     persistent writes. Checked against a control's name ONLY —
#                navigating somewhere never counts as mutating it.
#
# Setting SAFETY_<LIST> REPLACES the built-in list; leaving it unset keeps the
# defaults shown below. SAFETY_<LIST>_EXTRA appends instead, which is what you
# want for a one-term tweak. Set a list to an empty string to disable it.
#
# Matching is by SUBSTRING and a trailing space is significant — "add " matches
# "Add user" but not "Address". Only leading whitespace is stripped, so keep the
# space in "add " / "new " / "run " if you restate those terms.
#
# SAFETY_NEVER_TOUCH=log out,logout,sign out,signout,billing,payment,credit card,subscription,account settings,security,api key,password,delete account,danger zone
# SAFETY_DESTRUCTIVE=delete,remove,destroy,erase,clear all,wipe,cancel subscription,downgrade,deactivate,disable account,close account,send,publish,submit order,pay,purchase,checkout,buy,invite,share externally,transfer,archive,revoke
# SAFETY_MUTATING=create,new ,add ,save,generate,run ,execute,upload,import
#
# Append one term without restating a list:
# SAFETY_DESTRUCTIVE_EXTRA=escalate,assign
#
# Per-product opt-in still lives in product.json `allowActions` (e.g. ["create"]
# for a dedicated sandbox). NEVER_TOUCH ignores it by design.
