{
  "name": "@sable/web-sdk-ui",
  "version": "0.1.0",
  "description": "Isolated Shadow DOM user interface for the Sable Web SDK",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": "./dist/sable-ui.min.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:module": "tsc -p tsconfig.build.json",
    "build:browser": "esbuild src/browser-entry.ts --bundle --minify --format=iife --global-name=SableUI --target=es2020 --outfile=dist/sable-ui.min.js",
    "build": "npm run clean && npm run build:module && npm run build:browser",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@sable/web-sdk": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
