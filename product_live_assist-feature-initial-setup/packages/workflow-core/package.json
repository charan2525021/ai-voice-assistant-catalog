{
  "name": "@sable/workflow-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-neutral, deterministic Sable workflow execution engine.",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "npm --prefix ../sdk-contracts run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@sable/sdk-contracts": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
